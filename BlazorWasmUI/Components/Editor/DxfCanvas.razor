@namespace BlazorWasmUI.Components.Editor
@using BlazorWasmUI.Models
@using BlazorWasmUI.Services
@inject IJSRuntime Js
@inject WorkspaceState Workspace
@inject DxfImportService ImportService
@implements IAsyncDisposable

<div class="dxf-canvas-host">
    <canvas @ref="_canvas" class="dxf-canvas"></canvas>
</div>

<button type="button"
        class="dxf-canvas__info-btn"
        title="How to use"
        aria-label="How to use"
        @onclick="OpenInfo">
    <img src="img/info.svg" alt="" class="dxf-canvas__info-icon" />
</button>

@if (!string.IsNullOrWhiteSpace(Workspace.StatusMessage))
{
    <div class="dxf-status">@Workspace.StatusMessage</div>
}

<InfoHelpModal IsOpen="_infoOpen" OnClose="CloseInfo" />
