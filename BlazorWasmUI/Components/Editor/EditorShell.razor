@namespace BlazorWasmUI.Components.Editor

<div class="editor-shell">
    <header class="editor-shell__top">
        <span class="editor-shell__brand">Dxf Editor</span>
    </header>
    <div class="editor-shell__body">
        <div class="editor-shell__left">
            <LeftToolsPanel />
        </div>
        <div class="editor-shell__canvas">
            <DxfCanvas />
        </div>
        <div class="editor-shell__right">
            <LayerEditPanel />
            <PartsListPanel />
        </div>
    </div>
    <div class="editor-shell__bottom">
        <LayerBarPanel />
    </div>
</div>
