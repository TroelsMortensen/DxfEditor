@namespace BlazorWasmUI.Components.Editor
@using BlazorWasmUI.Services
@inject WorkspaceState Workspace
@inject DxfImportService ImportService
@inject DxfExportService ExportService
@implements IDisposable

<aside class="tools-panel">
    <div class="tools-panel__group tools-panel__group--top">
        <button type="button"
                class="tool-btn"
                title="Mirror selection horizontally"
                disabled="@(!Workspace.HasSelection)"
                @onclick="MirrorHorizontal">
            <img src="img/mirror-tool.svg" alt="" class="tool-icon" />
        </button>
        <button type="button"
                class="tool-btn"
                title="Mirror selection vertically"
                disabled="@(!Workspace.HasSelection)"
                @onclick="MirrorVertical">
            <img src="img/mirror-tool.svg" alt="" class="tool-icon tool-icon--rotated" />
        </button>
        <button type="button"
                class="tool-btn"
                title="Duplicate selection (Ctrl/Cmd+D)"
                disabled="@(!Workspace.HasSelection)"
                @onclick="Duplicate">
            <img src="img/duplicate.svg" alt="" class="tool-icon" />
        </button>
        <button type="button"
                class="tool-btn"
                title="Delete selection (Delete)"
                disabled="@(!Workspace.HasSelection)"
                @onclick="DeleteAsync">
            <img src="img/delete.svg" alt="" class="tool-icon" />
        </button>
    </div>
    <div class="tools-panel__divider" aria-hidden="true"></div>
    <div class="tools-panel__spacer" aria-hidden="true"></div>
    <div class="tools-panel__divider" aria-hidden="true"></div>
    <div class="tools-panel__group tools-panel__group--bottom">
        <label class="tool-btn" title="Import DXF files">
            <img src="img/import.svg" alt="" class="tool-icon" />
            <InputFile @key="_importInputKey"
                       OnChange="OnFilesSelected"
                       accept=".dxf"
                       multiple
                       style="display: none;" />
        </label>
        <button type="button"
                class="tool-btn"
                title="Export master DXF"
                disabled="@(Workspace.Parts.Count == 0)"
                @onclick="ExportAsync">
            <img src="img/export.svg" alt="" class="tool-icon" />
        </button>
    </div>
</aside>
